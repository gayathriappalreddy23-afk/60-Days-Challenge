import threading
import time

def task_alpha(duration):
    print(f"[Alpha Thread] Running for {duration} seconds...")
    time.sleep(duration)
    print("[Alpha Thread] Task complete.")

def task_beta(msg):
    print(f"[Beta Thread] Processing custom system message: {msg}")
    time.sleep(0.3)
    print("[Beta Thread] Logic fully executed.")

# Instantiating threads with cleanly named targets and specific arguments
worker_one = threading.Thread(target=task_alpha, args=(0.8,))
worker_two = threading.Thread(target=task_beta, args=("System_Initialized_Successfully",))

print("\n--- Starting Thread Batch #11 ---")
worker_one.start()
worker_two.start()

# Syncing back to main execution path
worker_one.join()
worker_two.join()
print("--- Batch #11 Successfully Completed ---\n")



