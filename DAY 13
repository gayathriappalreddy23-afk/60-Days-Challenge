import threading
import time

#2

def process_data(data_item):
    print(f"Thread {threading.current_thread().name} is processing: {data_item}")
    time.sleep(0.5) 

items = ["Data_A", "Data_B", "Data_C", "Data_D"]
threads = []
for item in items:
    t = threading.Thread(target=process_data, args=(item,))
    threads.append(t)
    t.start()
for t in threads:
    t.join()

print("All data processed safely.")

